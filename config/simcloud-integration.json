{
  "schema": "simforge-oss.simcloud-integration/v2",
  "platformRepository": "https://github.com/SimForgeinc/simcloud-platform",
  "sourceStackConfig": "config/simforge-oss-stack.json",
  "vendorLock": "vendor/simforge-oss/stack-lock.json",
  "consumerManifest": "package.json",
  "consumerLock": "package-lock.json",
  "pythonConsumerManifest": "services/render-worker/pyproject.toml",
  "pythonConsumerLock": "services/render-worker/uv.lock",
  "platformServices": [
    "services/scenario-compiler",
    "services/render-worker"
  ],
  "requireExactSourceRevision": true,
  "forbiddenDuplicatePackages": [
    "@simforge-oss/scenario",
    "@simforge-oss/engine",
    "@simforge-oss/maps",
    "@simforge-oss/compiler",
    "@simforge-oss/viewer",
    "@simforge-oss/editor",
    "@simforge-oss/playback",
    "@simforge-oss/asset-catalog",
    "@simforge-oss/render",
    "@simforge-oss/openscenario",
    "@simforge-oss/training-env",
    "@simforge-oss/evaluation",
    "@simforge-oss/cli",
    "@simforge-oss/map-pipeline",
    "@simforge-oss/map-registry"
  ],
  "forbiddenPaths": [
    "packages/scenario",
    "packages/engine",
    "packages/maps",
    "packages/compiler",
    "packages/viewer",
    "packages/editor",
    "packages/playback",
    "packages/asset-catalog",
    "packages/render",
    "packages/openscenario",
    "packages/training-env",
    "packages/evaluation",
    "packages/cli",
    "packages/map-pipeline",
    "packages/map-registry"
  ],
  "adapterSurfaces": [],
  "sourceScanRoots": [
    "apps",
    "docker",
    "infra",
    "packages",
    "scripts",
    "services"
  ],
  "importScanIgnoreFiles": [],
  "forbiddenImportPatterns": [
    "@simforge-oss/(scenario|engine|maps|compiler|viewer|editor|playback|asset-catalog|render|openscenario|training-env|evaluation|cli|map-pipeline|map-registry)/(src|dist)/"
  ]
}
