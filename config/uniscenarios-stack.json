{
  "schema": "uniscenarios.stack-config/v1",
  "stackVersion": "0.1.0-rc.45",
  "repository": "https://github.com/SimForgeinc/UniScenarios",
  "contracts": {
    "scenarioTemplate": "2",
    "simulationStepSeconds": 0.02,
    "openScenarioXml": "1.4.0",
    "openScenarioDsl": "2.2.0",
    "carlaExecution": "uniscenarios.carla-execution/v1"
  },
  "packages": [
    {
      "path": "packages/scenario-model",
      "role": "scenario-contract"
    },
    {
      "path": "packages/sim-engine",
      "role": "simulation-kernel"
    },
    {
      "path": "packages/ambient-traffic",
      "role": "ambient-traffic-contracts"
    },
    {
      "path": "packages/scenario-materializer",
      "role": "materializer"
    },
    {
      "path": "packages/map-intel",
      "role": "map-intelligence"
    },
    {
      "path": "packages/anchor-matcher",
      "role": "anchor-matching"
    },
    {
      "path": "packages/xodr-tools",
      "role": "opendrive"
    },
    {
      "path": "packages/city-renderer",
      "role": "renderer"
    },
    {
      "path": "packages/editor-core",
      "role": "editor-core"
    },
    {
      "path": "packages/editor-ui",
      "role": "editor-presentation"
    },
    {
      "path": "packages/camera-rig",
      "role": "camera-presentation"
    },
    {
      "path": "packages/playback",
      "role": "playback-runtime"
    },
    {
      "path": "packages/prop-catalog",
      "role": "actor-catalog"
    },
    {
      "path": "packages/render-runtime",
      "role": "render-contract-runtime"
    },
    {
      "path": "packages/browser-renderer",
      "role": "browser-renderer"
    },
    {
      "path": "services/render-worker",
      "role": "portable-render-worker"
    },
    {
      "path": "packages/trace-comparator",
      "role": "trace-conformance"
    },
    {
      "path": "packages/cli",
      "role": "cli-and-openscenario"
    },
    {
      "path": "packages/openscenario",
      "role": "openscenario-public-api"
    },
    {
      "path": "packages/esmini-runner",
      "role": "local-execution-adapter"
    }
  ],
  "pythonPackages": [
    {
      "path": "adapters/carla-bridge",
      "name": "uniscenarios-carla-bridge",
      "version": "0.1.0rc45",
      "role": "optional-carla-execution-adapter",
      "registry": "pypi"
    }
  ]
}
