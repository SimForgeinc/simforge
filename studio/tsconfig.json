{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@simforge-oss/studio-shared": [
        "./app/lib/studio-shared/index.ts"
      ],
      "@simforge-oss/studio-shared/scenario-render-control": [
        "./app/lib/studio-shared/scenario-render-control.ts"
      ],
      "@simforge-oss/studio-shared/*": [
        "./app/lib/studio-shared/*"
      ],
      "@simforge-oss/asset-catalog": ["../packages/asset-catalog/src/index.ts"],
      "@simforge-oss/asset-catalog/metadata": ["../packages/asset-catalog/src/metadata.ts"],
      "@simforge-oss/cli": ["../packages/cli/src/index.ts"],
      "@simforge-oss/compiler": ["../packages/compiler/src/index.ts"],
      "@simforge-oss/compiler/node": ["../packages/compiler/src/node.ts"],
      "@simforge-oss/editor": ["../packages/editor/src/index.ts"],
      "@simforge-oss/engine": ["../packages/engine/src/index.ts"],
      "@simforge-oss/engine/scene-state": ["../packages/engine/src/scene-state/index.ts"],
      "@simforge-oss/evaluation": ["../packages/evaluation/src/index.ts"],
      "@simforge-oss/maps": ["../packages/maps/src/index.ts"],
      "@simforge-oss/maps/node": ["../packages/maps/src/node.ts"],
      "@simforge-oss/maps/opendrive": ["../packages/maps/src/opendrive.ts"],
      "@simforge-oss/openscenario": ["../packages/openscenario/src/index.ts"],
      "@simforge-oss/openscenario/esmini": ["../packages/openscenario/src/esmini/index.ts"],
      "@simforge-oss/openscenario/execution-plan": ["../packages/openscenario/src/execution-plan.ts"],
      "@simforge-oss/openscenario/export": ["../packages/openscenario/src/export/index.ts"],
      "@simforge-oss/openscenario/export/types": ["../packages/openscenario/src/export/types.ts"],
      "@simforge-oss/openscenario/export/xml-1.4": ["../packages/openscenario/src/export/xml-1.4.ts"],
      "@simforge-oss/openscenario/import": ["../packages/openscenario/src/import.ts"],
      "@simforge-oss/openscenario/node": ["../packages/openscenario/src/node/index.ts"],
      "@simforge-oss/openscenario/trace-diff": ["../packages/openscenario/src/trace-diff/index.ts"],
      "@simforge-oss/playback": ["../packages/playback/src/index.ts"],
      "@simforge-oss/playback/traffic": ["../packages/playback/src/traffic/index.ts"],
      "@simforge-oss/render": ["../packages/render/src/index.ts"],
      "@simforge-oss/render/native": ["../packages/render/src/native/index.ts"],
      "@simforge-oss/render/web": ["../packages/render/src/web/index.ts"],
      "@simforge-oss/scenario": ["../packages/scenario/src/index.ts"],
      "@simforge-oss/training-env": ["../packages/training-env/src/index.ts"],
      "@simforge-oss/viewer": ["../packages/viewer/src/index.ts"],
      "@simforge-oss/viewer/react": ["../packages/viewer/src/react.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "worker",
    "test-only",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/*.cli.ts",
    "app/lib/studio-shared/auth",
    "app/lib/studio-shared/bin"
  ]
}
