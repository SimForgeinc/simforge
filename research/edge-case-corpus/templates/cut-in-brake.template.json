{
  "scenarioVersion": 2,
  "meta": {
    "name": "Close cut-in followed by braking",
    "description": "A faster adjacent vehicle inserts ahead of ego at low headway, then brakes before the following gap can recover.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "longitudinal.cut-in-brake",
    "tags": ["corridor", "longitudinal", "cut-in", "braking", "low-headway"],
    "author": "agent/corridor-mechanisms",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      { "id": "insertionLeadM", "type": "continuous", "unit": "m", "tier": 1, "range": [16, 18], "default": 17, "distribution": "uniform" },
      { "id": "lateralRateMps", "type": "continuous", "unit": "m/s", "tier": 1, "range": [1.3, 1.7], "default": 1.5, "distribution": "uniform" },
      { "id": "cutInDecelMps2", "type": "continuous", "unit": "m/s^2", "tier": 1, "range": [5, 5.5], "default": 5.25, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "noon" },
  "anchor": {
    "id": "cut-in-brake",
    "corridor": {
      "throughLanesSameDir": { "value": [2, 8], "essentiality": "required" },
      "speedLimitKph": { "value": [35, 80], "essentiality": "preferred", "weight": 2 },
      "curvatureDegPer10m": { "value": [0, 5], "essentiality": "required" },
      "runwayDownstreamM": { "value": [240, null], "essentiality": "required" },
      "laneChangeLegal": { "value": { "side": "either", "sRange": [30, 150] }, "essentiality": "required" }
    },
    "features": [],
    "policy": { "allowMirror": true, "maxSitesPerMap": 12, "diversity": "moderate", "minScore": 0.5 }
  },
  "roles": [
    {
      "id": "ego", "kind": "on_reference", "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "pose": { "laneOffset": 0, "s": 28, "tFrac": 0, "headingOffsetRad": 0 },
      "initialSpeedKph": "clamp(0.82 * lane.speedLimitKph, 30, 55)"
    },
    {
      "id": "cut-in", "kind": "relative_to", "label": "adjacent vehicle that merges into ego's gap",
      "actor": { "class": "car", "catalogId": "vehicle.hatchback" },
      "requiredSameRoadSectionAs": "ego",
      "requiredHeadingRelation": { "role": "ego", "relation": "parallel", "maxErrorDeg": 10 },
      "ref": "ego", "dLane": -1, "dsM": "-param.insertionLeadM", "tFrac": 0, "headingOffsetRad": 0,
      "initialSpeedKph": "clamp(0.92 * lane.speedLimitKph, 33, 60)"
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 8,
    "warmupSeconds": 2,
    "interactions": [
      {
        "id": "cut-in-enters", "actor": "cut-in", "verb": "changeLane", "trigger": { "kind": "at", "t": 1 },
        "target": { "mode": "toRole", "role": "ego" },
        "dynamics": { "shape": "sinusoidal", "constraint": "rate", "value": "param.lateralRateMps" }
      },
      {
        "id": "cut-in-brakes", "actor": "cut-in", "verb": "speed", "trigger": { "kind": "after", "of": "cut-in-enters", "event": "start", "delayS": 2.6 },
        "target": { "mode": "factor", "factor": 0.3 },
        "dynamics": { "shape": "linear", "constraint": "rate", "value": "param.cutInDecelMps2" }
      },
      {
        "id": "ego-brakes", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "cut-in-brakes", "event": "start", "delayS": 1.1 },
        "target": { "mode": "stop" },
        "dynamics": { "shape": "linear", "constraint": "rate", "value": 5.5 }
      }
    ]
  },
  "invariants": [
    { "id": "post-merge-headway", "kind": "headway", "of": "ego", "to": "cut-in", "range": [0.35, 1.25], "window": [3.5, 7], "essentiality": "required" },
    { "id": "cut-in-criticality", "kind": "ttc", "of": "ego", "to": "cut-in", "range": [0.5, 3], "mode": "min", "window": [3.5, 7], "essentiality": "required" },
    { "id": "cut-in-sequence", "kind": "event_order", "events": ["cut-in-enters", "cut-in-brakes", "ego-brakes"], "strict": true, "minSeparationS": 1.1, "essentiality": "required" },
    { "id": "ego-braking-budget", "kind": "decel_budget", "of": "ego", "maxMps2": 8, "essentiality": "required" },
    { "id": "stable-aftermath-clearance", "kind": "gap", "of": "ego", "to": "cut-in", "unit": "distance", "range": [4.5, null], "window": [5.5, 8], "essentiality": "required" }
  ],
  "variants": [],
  "metricSubject": "ego"
}
