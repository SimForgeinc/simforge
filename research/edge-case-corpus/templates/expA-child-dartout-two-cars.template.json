              "headingOffsetRad": 0
            },
            {
              "laneOffset": 0,
              "s": 141,
              "tFrac": 0.1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": 0,
              "s": 143.5,
              "tFrac": 1.0,
              "headingOffsetRad": 0
            }
          ]
        }
      },
