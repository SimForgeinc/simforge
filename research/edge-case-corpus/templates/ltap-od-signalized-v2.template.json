 "props": [],
 "choreography": {
  "clipSeconds": 12,
  "warmupSeconds": 2,
  "interactions": [
   {
    "id": "ego-permissive-green",
    "label": "bind the ego movement to its physical controller/head group and explicitly choose the synthetic-default permissive-green state at t=0",
    "actor": "@world",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "signal:feature:jx:ego.phase",
     "value": "green"
    }
   },
   {
    "id": "opposing-through-green",
    "label": "the opposing through movement shares the permissive interval; map binding is authoritative while the t=0 timing state is explicitly authored",
    "actor": "@world",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "signal:feature:jx:opposing.phase",
     "value": "green"
    }
   },
   {
    "id": "ego-commits",
    "label": "ego does not wait for a gap \u2014 the defining error of an LTAP/OD",
    "actor": "ego",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "rules.yieldToVehicles",
     "value": false
    }
   },
   {
    "id": "ego-disables-avoidance",
    "label": "ego physically commits to the accepted left-turn gap instead of silently braking away from it",
    "actor": "ego",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "rules.collisionAvoidance",
     "value": false
    }
   },
   {
    "id": "ego-takes-bound-left-turn",
    "label": "the authored action closes against the matcher's exact physical left-turn movement",
    "actor": "ego",
    "verb": "route",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "mode": "turn",
     "feature": "jx",
     "turn": "left"
    }
   },
   {
    "id": "oncoming-holds",
    "label": "through traffic has right of way and does not give it up",
    "actor": "oncoming",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "rules.yieldToVehicles",
     "value": false
    }
   },
   {
    "id": "oncoming-commits",
    "label": "the oncoming driver has not seen ego yet, so it does not brake for it",
    "actor": "oncoming",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "rules.collisionAvoidance",
     "value": false
    }
   },
   {
    "id": "ego-slows-for-the-turn",
    "label": "ego drops to a turning speed on the approach",
    "actor": "ego",
    "verb": "speed",
    "trigger": {
     "kind": "when",
     "condition": {
      "kind": "distance",
      "from": "ego",
      "to": {
       "feature": "jx",
       "at": "entry"
      },
      "measure": "euclidean",
      "op": "<=",
      "valueM": 30
     },
     "byLatest": 12,
     "ifNever": "fire"
    },
    "target": {
     "mode": "absolute",
     "valueKph": "clamp(0.6 * lane.speedLimitKph, 18, 34)"
    },
    "dynamics": {
     "shape": "linear",
     "constraint": "rate",
     "value": 2.2
    }
   }
  ]
 },
