   {
    "id": "arrivalTtc",
    "type": "continuous",
    "description": "Seconds between ego reaching the conflict point and the oncoming car reaching it. 1.2-2.5 s is the band where an unprotected left goes from routine to critical.",
    "unit": "s",
    "tier": 1,
    "range": [
     1.2,
     2.5
    ],
    "default": 2.0,
    "distribution": "uniform"
   }
  ],
  "constraints": []
 },
