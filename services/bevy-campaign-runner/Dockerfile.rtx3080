FROM ubuntu:24.04

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/SimForgeinc/UniScenarios" \
      org.opencontainers.image.title="SimForge standalone Bevy campaign runner" \
      ai.simforge.hardware-profile="rtx3080-10gb-v1"

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ffmpeg libasound2t64 libudev1 libvulkan1 libx11-6 libxkbcommon0 python3 \
 && rm -rf /var/lib/apt/lists/*

COPY renderer/target/release/scen-play /usr/local/bin/scen-play
COPY renderer/target/release/sensor-capture /usr/local/bin/sensor-capture
COPY scripts/bevy-campaign-parity.py /usr/local/bin/bevy-campaign-parity

RUN chmod 0755 /usr/local/bin/scen-play /usr/local/bin/sensor-capture /usr/local/bin/bevy-campaign-parity
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/bevy-campaign-parity"]
