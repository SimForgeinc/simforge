# EnvironmentFile for uniscenarios-native-worker@browser-0 — copy to
# /opt/simforge/uniscenarios-native/env/browser-0.env and fill the token +
# chromium path (bootstrap-host.sh writes it to
# /opt/simforge/uniscenarios-native/chromium-path).
UNISCENARIO_RENDER_WORKER_TOKEN=<node-scoped worker token>
NODE_ENV=production
UNISCENARIOS_BROWSER_ENGINE_MODULE=/opt/simforge/uniscenarios-native/current/browser-renderer/dist/index.js
CHROMIUM_EXECUTABLE_PATH=<contents of /opt/simforge/uniscenarios-native/chromium-path>
UNISCENARIOS_CHROMIUM_EXTRA_ARGS=--use-gl=angle --use-angle=gl-egl
__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
UNISCENARIOS_SCRATCH_DIR=/opt/simforge/uniscenarios-native/state/scratch
