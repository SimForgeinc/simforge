# EnvironmentFile for uniscenarios-native-worker@carla-0 — copy to
# /opt/simforge/uniscenarios-native/env/carla-0.env and fill the token.
# Mirrors the env the containerized carla worker ran with; the CARLA engine
# stays in its pinned container (server), reached over RPC on CARLA_PORT.
UNISCENARIO_RENDER_WORKER_TOKEN=<node-scoped worker token>
NODE_ENV=production
CARLA_HOST=127.0.0.1
CARLA_PORT=2010
UNISCENARIOS_CARLA_BINARY=/opt/simforge/uniscenarios-native/venv/bin/uniscenarios-carla
UNISCENARIOS_CARLA_BLUEPRINT_ID=vehicle.kia.carnival
UNISCENARIOS_CARLA_BLUEPRINT_CLASS=/Game/Carla/Blueprints/Vehicles/KiaCarnival2025/BP_KiaCarnival2025.BP_KiaCarnival2025_C
UNISCENARIOS_CARLA_IMAGE_MANIFEST_SHA256=baed0d038437c55efe0abe52a762d352aeb21acdeeff5b11a15f6bd8a648de64
UNISCENARIO_CARLA_COOKED_MAPS_JSON={"Richmond_Field_Station_Richmond_CA":"80704cd1bc2563a63d5d365a5b0c43936222cef811f513e89129a8205e464643","Belmont_Office_Park_Belmont_CA":"35cf2b16a1d308c6436089a0edf66f20c87a79da12e79472a03a2f568ba28f63"}
UNISCENARIO_CARLA_ALLOW_GENERATED_XODR=1
UNISCENARIO_RGB_STDOUT_VIDEO=1
UNISCENARIO_SENSOR_FRAME_TIMEOUT_S=300
UNISCENARIOS_SCRATCH_DIR=/opt/simforge/uniscenarios-native/state/scratch
