{
  "name": "@simforge/openscenario",
  "version": "0.1.0-rc.45",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge.git",
    "directory": "packages/openscenario"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "default": "./dist/import.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./export/types": {
      "types": "./dist/export/types.d.ts",
      "default": "./dist/export/types.js"
    },
    "./export/xml-1.4": {
      "types": "./dist/export/xml-1.4.d.ts",
      "default": "./dist/export/xml-1.4.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./execution-plan": {
      "types": "./dist/execution-plan.d.ts",
      "default": "./dist/execution-plan.js"
    },
    "./esmini": {
      "types": "./dist/esmini/index.d.ts",
      "default": "./dist/esmini/index.js"
    },
    "./trace-diff": {
      "types": "./dist/trace-diff/index.d.ts",
      "default": "./dist/trace-diff/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/import.ts src/export/index.ts src/export/types.ts src/export/xml-1.4.ts src/node/index.ts src/execution-plan.ts src/esmini/index.ts src/trace-diff/index.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@simforge/engine": "workspace:*",
    "@simforge/scenario": "workspace:*",
    "fast-xml-parser": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "execa": "^9.5.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
