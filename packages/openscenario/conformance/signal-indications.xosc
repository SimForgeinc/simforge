    <Story name="uniscenarios_story">
      <Act name="uniscenarios_act">
        <ManeuverGroup name="group_ego" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="actor_ego"/></Actors>
          <Maneuver name="maneuver_ego">
            <Event name="event_signal_replay_10" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_10_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="yellow"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_10_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="0.2" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_20" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_20_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="red"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_20_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="0.4" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_31" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_31_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="flashing_yellow"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_31_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="0.62" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_40" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_40_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="flashing_red"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_40_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="0.8" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_50" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_50_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="off"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_50_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="1" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_60" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_60_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="green_arrow"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_60_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="1.2" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_70" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_70_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="yellow_arrow"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_70_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="1.4" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_80" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_80_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="red_x"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_80_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="1.6" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_90" priority="overwrite" maximumExecutionCount="1">
              <Action name="event_signal_replay_90_action_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="head-1" state="proceed"/></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
              <StartTrigger><ConditionGroup><Condition name="event_signal_replay_90_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="1.8" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="event_signal_replay_100" priority="overwrite" maximumExecutionCount="1">
