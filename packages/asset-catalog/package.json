{
  "name": "@simforge-oss/asset-catalog",
  "version": "0.1.0-rc.61",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/asset-catalog"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./metadata": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      },
      "./catalog.json": "./catalog.json"
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "development": "./src/metadata.ts",
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./catalog.json": "./catalog.json"
  },
  "files": [
    "dist",
    "catalog.json"
  ],
  "dependencies": {
    "three": "^0.185.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.185.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "pnpm run catalog && tsup src/index.ts src/metadata.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "catalog": "tsx scripts/generate-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sheet": "node scripts/render-contact-sheet.mjs"
  }
}
