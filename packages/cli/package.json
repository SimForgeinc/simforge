{
  "name": "@simforge/cli",
  "version": "0.1.0-rc.46",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "simforge": "./bin/simforge.js",
    "sf": "./bin/sf.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:portable": "vitest run src/__tests__/asam-export.test.ts src/__tests__/esmini-bundle.test.ts src/__tests__/xml14-suite-audit.test.ts src/__tests__/evidence.test.ts src/__tests__/intent-evaluate.test.ts src/__tests__/invariants.test.ts src/__tests__/seeding.test.ts src/__tests__/prop-dims.test.ts",
    "audit:xml14-suite": "tsx src/tools/audit-xml14-suite.ts",
    "simforge": "tsx src/main.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@simforge/compiler": "workspace:*",
    "@simforge/engine": "workspace:*",
    "@simforge/maps": "workspace:*",
    "@simforge/map-registry": "workspace:*",
    "@simforge/map-pipeline": "workspace:*",
    "@simforge/openscenario": "workspace:*",
    "@simforge/render": "workspace:*",
    "@simforge/scenario": "workspace:*",
    "meshoptimizer": "^1.2.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "execa": "^9.5.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
