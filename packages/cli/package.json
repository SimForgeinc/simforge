{
  "name": "@uniscenarios/cli",
  "version": "0.1.0-rc.45",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/UniScenarios.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "uniscenarios": "./bin/uniscenarios.js",
    "scen": "./bin/scen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:portable": "vitest run src/__tests__/asam-export.test.ts src/__tests__/esmini-bundle.test.ts src/__tests__/xml14-suite-audit.test.ts src/__tests__/evidence.test.ts src/__tests__/intent-evaluate.test.ts src/__tests__/invariants.test.ts src/__tests__/seeding.test.ts src/__tests__/prop-dims.test.ts",
    "audit:xml14-suite": "tsx src/tools/audit-xml14-suite.ts",
    "scen": "tsx src/main.ts",
    "uniscenarios": "tsx src/main.ts"
  },
  "dependencies": {
    "@uniscenarios/anchor-matcher": "workspace:*",
    "@uniscenarios/map-intel": "workspace:*",
    "@uniscenarios/openscenario": "workspace:*",
    "@uniscenarios/render-runtime": "workspace:*",
    "@uniscenarios/scenario-materializer": "workspace:*",
    "@uniscenarios/scenario-model": "workspace:*",
    "@uniscenarios/sim-engine": "workspace:*",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "execa": "^9.5.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
