{
  "name": "@uniscenarios/editor-core",
  "version": "0.1.0-rc.37",
  "description": "Framework-neutral UniScenarios v2 authoring document, interaction controller, route overlays, and editor contracts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/UniScenarios.git",
    "directory": "packages/editor-core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "three": "^0.182.0",
    "@uniscenarios/prop-catalog": "workspace:*",
    "@uniscenarios/scenario-model": "workspace:*",
    "@uniscenarios/sim-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
