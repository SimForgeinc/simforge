{
  "name": "@simforge-oss/viewer",
  "version": "0.1.0-rc.54",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/viewer"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "development": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simforge-oss/asset-catalog": "workspace:*",
    "@simforge-oss/engine": "workspace:*",
    "@simforge-oss/scenario": "workspace:*",
    "three": "^0.185.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/three": "^0.185.0",
    "react": "^19.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
