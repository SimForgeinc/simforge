{
  "name": "@simforge-oss/map-pipeline",
  "version": "0.1.0-rc.61",
  "description": "Deterministic source-map to registry-closure pipeline.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/map-pipeline"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./map-derivatives": {
        "types": "./dist/scripts/map-derivatives.d.mts",
        "default": "./dist/scripts/map-derivatives.mjs"
      },
      "./static-map-colliders": {
        "types": "./dist/scripts/static-map-colliders.d.mts",
        "default": "./dist/scripts/static-map-colliders.mjs"
      },
      "./snow-cover": {
        "types": "./dist/scripts/snow-cover.d.mts",
        "default": "./dist/scripts/snow-cover.mjs"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map-derivatives": {
      "development": "./scripts/map-derivatives.mjs",
      "types": "./dist/scripts/map-derivatives.d.mts",
      "default": "./dist/scripts/map-derivatives.mjs"
    },
    "./static-map-colliders": {
      "development": "./scripts/static-map-colliders.mjs",
      "types": "./dist/scripts/static-map-colliders.d.mts",
      "default": "./dist/scripts/static-map-colliders.mjs"
    },
    "./snow-cover": {
      "development": "./scripts/snow-cover.mjs",
      "types": "./dist/scripts/snow-cover.d.mts",
      "default": "./dist/scripts/snow-cover.mjs"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "dependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@simforge-oss/map-registry": "workspace:*",
    "@simforge-oss/maps": "workspace:*",
    "meshoptimizer": "1.2.0",
    "mikktspace": "1.1.1",
    "sharp": "0.34.5",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist && rm -rf dist/scripts && cp -r scripts dist/scripts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
