{
  "name": "@simforge/map-pipeline",
  "version": "0.1.0-rc.45",
  "description": "Deterministic source-map to registry-closure pipeline.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge.git",
    "directory": "packages/map-pipeline"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "scripts"],
  "dependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@simforge/maps": "workspace:*",
    "@simforge/map-registry": "workspace:*",
    "meshoptimizer": "1.2.0",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist && cp -r scripts dist/scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
