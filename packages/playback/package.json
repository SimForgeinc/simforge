{
  "name": "@simforge-oss/playback",
  "version": "0.1.0-rc.53",
  "description": "Deterministic SimForge trace loading, sampling, playback control, map runtime, collider, and browser traffic runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/playback"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./traffic": {
        "types": "./dist/traffic/index.d.ts",
        "default": "./dist/traffic/index.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./traffic": {
      "development": "./src/traffic/index.ts",
      "types": "./dist/traffic/index.d.ts",
      "default": "./dist/traffic/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simforge-oss/asset-catalog": "workspace:*",
    "@simforge-oss/engine": "workspace:*",
    "@simforge-oss/openscenario": "workspace:*",
    "@simforge-oss/scenario": "workspace:*",
    "@simforge-oss/viewer": "workspace:*",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
