{
  "name": "@simforge/playback",
  "version": "0.1.0-rc.45",
  "description": "Deterministic UniScenarios trace loading, sampling, playback control, map runtime, collider, and browser traffic runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/UniScenarios.git",
    "directory": "packages/playback"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./traffic": {
      "types": "./dist/traffic/index.d.ts",
      "default": "./dist/traffic/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simforge/asset-catalog": "workspace:*",
    "@simforge/engine": "workspace:*",
    "@simforge/openscenario": "workspace:*",
    "@simforge/scenario": "workspace:*",
    "@simforge/viewer": "workspace:*",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/traffic/index.ts src/traffic-provider/sumoWasmWorker.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
