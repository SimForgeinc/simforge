{
  "name": "@simforge/training-env",
  "version": "0.1.0-rc.46",
  "description": "Gymnasium-semantics environment core over the SimForge fixed-step engine: EnvSession (reset/step), observations (state vector, perception-gated object list, BEV raster), reward assembly, and the versioned causal ground-truth channel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/training-env"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "simforge-env-server": "./dist/env-server.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/env-server.ts --format esm --dts --sourcemap --clean --no-splitting --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx src/bench/env-bench.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@simforge/compiler": "workspace:*",
    "@simforge/engine": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
