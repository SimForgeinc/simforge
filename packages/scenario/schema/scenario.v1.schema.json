{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uniscenarios.dev/scenario.v1.schema.json",
  "title": "SimForge scenario, schema v1",
  "description": "Authoring format for SimForge (.scenario.json). Positions are metres in the y-up scene frame; headings are radians CCW about +Y from +X. Two constraints are not expressible here and are enforced by the reference implementation: entity ids must be unique within a document, and meta.modifiedAt must not precede meta.createdAt.",
  "type": "object",
  "properties": {
    "scenarioVersion": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "appVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "createdAt",
        "modifiedAt",
        "appVersion"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "mapId": {
          "type": "string",
          "minLength": 1
        },
        "mapName": {
          "type": "string",
          "minLength": 1
        },
        "xodrSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "mapId",
        "mapName"
      ],
      "additionalProperties": false
    },
    "entities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z_-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vehicle",
              "pedestrian"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "model": {
            "type": "object",
            "properties": {
              "catalogId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "catalogId"
            ],
            "additionalProperties": false
          },
          "pose": {
            "type": "object",
            "properties": {
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "headingRad": {
                "type": "number"
              }
            },
            "required": [
              "position",
              "headingRad"
            ],
            "additionalProperties": false
          },
          "laneRef": {
            "type": "object",
            "properties": {
              "roadId": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "laneId": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "s": {
                "type": "number",
                "minimum": 0
              },
              "t": {
                "default": 0,
                "type": "number"
              },
              "headingOffsetRad": {
                "default": 0,
                "type": "number"
              }
            },
            "required": [
              "roadId",
              "section",
              "laneId",
              "s"
            ],
            "additionalProperties": false
          },
          "dims": {
            "type": "object",
            "properties": {
              "length": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "length",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "kind",
          "model",
          "pose"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "default": [],
      "maxItems": 0,
      "type": "array",
      "items": {}
    },
    "triggers": {
      "default": [],
      "maxItems": 0,
      "type": "array",
      "items": {}
    },
    "lightPrograms": {
      "default": [],
      "maxItems": 0,
      "type": "array",
      "items": {}
    },
    "parameters": {
      "default": {},
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "scenarioVersion",
    "meta",
    "map"
  ],
  "additionalProperties": false
}
