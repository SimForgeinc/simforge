{
  "name": "@simforge-oss/scenario",
  "version": "0.1.0-rc.55",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/scenario"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contracts": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.js"
      },
      "./schema.json": "./schema/scenario.v1.schema.json",
      "./schema/template.v2.json": "./schema/scenario-template.v2.schema.json",
      "./schema/anchor.v2.json": "./schema/logical-anchor.v2.schema.json",
      "./schema/interactions.v2.json": "./schema/interactions.v2.schema.json"
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "development": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./schema.json": "./schema/scenario.v1.schema.json",
    "./schema/template.v2.json": "./schema/scenario-template.v2.schema.json",
    "./schema/anchor.v2.json": "./schema/logical-anchor.v2.schema.json",
    "./schema/interactions.v2.json": "./schema/interactions.v2.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "dependencies": {
    "immer": "^11.1.15",
    "zod": "^4.4.3",
    "zod-v3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "pnpm run schema && tsup src/index.ts src/contracts.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "schema": "tsx scripts/generate-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
