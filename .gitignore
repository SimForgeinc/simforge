node_modules/
dist/
/dev-assets

# Meshy generation is resumable local work; source and smoke checks stay tracked.
/tools/meshy/cache/
/tools/meshy/state.json
/tools/meshy/manifest.json
/tools/meshy/REPORT.md
# Versioned local map derivatives are reproducible and may be many gigabytes.
**/3d/variants/
*.local
.DS_Store
*.tsbuildinfo
playwright-report/
test-results/
research/evaluations/**/results.partial.json

# Local render and simulation evidence; publish through an artifact store or Git LFS.
/artifacts
/scripts/.ss-probe.mjs

# campaign artefacts: batches are re-derivable from the templates + replay keys,
# and traces are large binaries the library does not need to carry.
campaigns/*/batches/
campaigns/**/*.trace.json.gz
campaigns/**/work/*.match.json
.tools/

# Python bytecode from running the adapter test suite locally.
__pycache__/
.pytest_cache/
.venv/

# Stray runtime logs and packed npm artifacts.
*.log
*.tgz

# Catalog execution attempt work trees are re-derivable from ledgers + seeds.
catalog/*.json.work/
scripts/rl/runs/
scripts/rl/**/__pycache__/
scripts/rl/*.log

# Sensor corpus: decoded GLBs are large binaries, re-derivable via
# `simforge corpus build`; the checksummed manifests ARE committed so
# downstream lanes and CI can verify a local build against them.
.corpus/**/*
!.corpus/**/
!.corpus/*/manifest.json

# WS1 RealityAnchor: raw eval-corpus downloads (BDD100K images, nuScenes
# samples) and detector work caches are re-derivable from the committed
# corpus-manifest.v1.json per-item sha256 values; only the manifest is versioned.
tools/bridge-fidelity/.corpus/

# Next build output
studio/.next/
renderer/target/
