{
  "scenarioVersion": 2,
  "meta": {
    "name": "Bus-stop emergence — pedestrian from in front of a dwelling bus",
    "description": "A required real bus_stop feature anchors the scenario. A static dwelling bus actor sits at the stop with doors open, remains immobile, and is the declared line-of-sight occluder between ego and the alighting pedestrian. The pedestrian route is folded into the initial route so the lane-semantic arrival solver can place the actor at a real trace-critical conflict with the ego vehicle.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T16:02:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "C5.bus-stop-emergence",
    "tags": [
      "vru",
      "occlusion",
      "bus-stop",
      "transit",
      "campaign-occluded-pedestrian",
      "static-bus",
      "real-feature-point",
      "lane-semantic-arrival"
    ],
    "author": "agent/campaign-occluded-pedestrian",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      {
        "id": "arrivalTtc",
        "type": "continuous",
        "description": "Seconds between the pedestrian reaching the ego lane centre and the ego reaching the same point.",
        "unit": "s",
        "tier": 1,
        "range": [
          0.8,
          2.2
        ],
        "default": 1.6,
        "distribution": "uniform"
      },
      {
        "id": "pedSpeedKph",
        "type": "continuous",
        "description": "Pedestrian travel speed. An alighting passenger in a hurry runs; Euro NCAP walk = 5 km/h, run = 8 km/h.",
        "unit": "kph",
        "tier": 1,
        "range": [
          4,
          8.5
        ],
        "default": 5.4,
        "distribution": "uniform"
      },
      {
        "id": "busGapM",
        "type": "continuous",
        "description": "Metres between the bus centre and the line the pedestrian crosses on. The bus is 12.2 m long, so 7 m puts the pedestrian right across its bumper and 14 m gives a clear car-length of daylight first.",
        "unit": "m",
        "tier": 1,
        "range": [
          7,
          14
        ],
        "default": 9,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
  "environment": {
    "weather": "clear",
    "timeOfDay": "afternoon"
  },
  "anchor": {
    "id": "bus-stop-emergence",
    "corridor": {
      "throughLanesSameDir": {
        "value": [
          1,
          4
        ],
        "essentiality": "required"
      },
      "speedLimitKph": {
        "value": [
          25,
          60
        ],
        "essentiality": "preferred",
        "weight": 3
      },
      "requiresAdjacent": {
        "value": [
          "sidewalk"
        ],
        "essentiality": "preferred",
        "weight": 2
      },
      "curvatureDegPer10m": {
        "value": [
          0,
          7
        ],
        "essentiality": "required"
      },
      "runwayDownstreamM": {
        "value": [
          210,
          null
        ],
        "essentiality": "required"
      }
    },
    "features": [
      {
        "id": "stop",
        "kind": "bus_stop",
        "label": "real kerbside bus stop, required",
        "essentiality": "required",
        "atM": {
          "value": [
            70,
            165
          ],
          "essentiality": "required"
        },
        "side": {
          "value": "right",
          "essentiality": "preferred"
        }
      }
    ],
    "policy": {
      "allowMirror": false,
      "maxSitesPerMap": 8,
      "diversity": "moderate",
      "minScore": 0.5
    }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "lane_offset",
      "k": -2,
      "onMissing": "fail",
      "label": "the vehicle under test",
      "actor": {
        "class": "car",
        "catalogId": "vehicle.sedan"
      },
      "essentiality": "required",
      "pose": {
        "laneOffset": 0,
        "s": "25.5 - param.busGapM - clamp(0.8 * lane.speedLimitKph, 22, 50) / 3.6 * 8",
        "tFrac": 0,
        "headingOffsetRad": 0
      },
      "initialSpeedKph": "clamp(0.8 * lane.speedLimitKph, 22, 50)",
      "extensions": {
        "placementFeature": "stop"
      }
    },
    {
      "id": "bus",
      "kind": "lane_offset",
      "k": -3,
      "onMissing": "fail",
      "pose": {
        "laneOffset": 0,
        "s": "9 - param.busGapM",
        "tFrac": -0.4,
        "headingOffsetRad": 0
      },
      "label": "dwelling static bus at the real bus stop",
      "actor": {
        "class": "bus",
        "catalogId": "vehicle.bus",
        "static": true
      },
      "essentiality": "required",
      "initialSpeedKph": 0,
      "extensions": {
        "placementFeature": "stop",
        "occludes": {
          "observer": "ego",
          "target": "ped"
        }
      }
    },
    {
      "id": "ped",
      "kind": "relative_to",
      "label": "the alighting passenger that walks round the front of the bus",
      "actor": {
        "class": "pedestrian"
      },
      "essentiality": "required",
      "initialSpeedKph": "param.pedSpeedKph",
      "ref": "ego",
      "dLane": 0,
      "dsM": 60,
      "tFrac": -1,
      "headingOffsetRad": 0,
      "extensions": {
        "placementFeature": "stop"
      }
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "bus-curbside-doors-open",
        "label": "the dwelling bus has its right-side passenger doors open at the kerb",
        "actor": "bus",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": -1
        },
        "target": {
          "key": "doors.right",
          "value": "open"
        }
      },
      {
        "id": "ped-commits",
        "label": "an alighting passenger stepping round a bus does not look for the second lane",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.collisionAvoidance",
          "value": false
        }
      },
      {
        "id": "ped-ignores-traffic",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.yieldToVehicles",
          "value": false
        }
      },
      {
        "id": "ped-rounds-the-bus",
        "label": "from the alighting point, along the kerb side, around the bus nose, then into the carriageway",
        "actor": "ped",
        "verb": "route",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "mode": "polyline",
          "points": [
            {
              "laneOffset": -3,
              "s": "14.8 - param.busGapM",
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": -3,
              "s": "16 - param.busGapM",
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": -3,
              "s": "23.5 - param.busGapM",
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": -2,
              "s": "25.5 - param.busGapM",
              "tFrac": 0,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": -2,
              "s": "25.5 - param.busGapM",
              "tFrac": 0.8,
              "headingOffsetRad": 0
            }
          ]
        }
      },
      {
        "id": "ped-reaches-the-lane",
        "label": "the arrival relation that makes the clip critical rather than incidental",
        "actor": "ped",
        "verb": "speed",
        "trigger": {
          "kind": "arrival",
          "of": "ped",
          "at": {
            "pose": {
              "laneOffset": -2,
              "s": "25.5 - param.busGapM",
              "tFrac": 0,
              "headingOffsetRad": 0
            }
          },
          "syncWith": "ego",
          "ttc": "param.arrivalTtc"
        },
        "target": {
          "mode": "absolute",
          "valueKph": "param.pedSpeedKph"
        },
        "dynamics": {
          "shape": "step",
          "constraint": "time",
          "value": 0.1
        }
      }
    ]
  },
  "invariants": [
    {
      "id": "criticality",
      "kind": "pet",
      "label": "the ego must actually be threatened by the pedestrian",
      "essentiality": "required",
      "of": "ego",
      "to": "ped",
      "range": [
        0.2,
        3
      ],
      "window": [
        4,
        10
      ]
    },
    {
      "id": "arrival-band",
      "kind": "arrival",
      "label": "the solved arrival offset must survive the run",
      "essentiality": "required",
      "of": "ped",
      "at": {
        "pose": {
          "laneOffset": -2,
          "s": "25.5 - param.busGapM",
          "tFrac": 0,
          "headingOffsetRad": 0
        }
      },
      "syncWith": "ego",
      "deltaTRange": [
        -3,
        -0.6
      ]
    },
    {
      "id": "ego-decel-budget",
      "kind": "decel_budget",
      "label": "beyond a hard stop the conflict was unavoidable, which is a different finding",
      "essentiality": "preferred",
      "of": "ego",
      "maxMps2": 8
    }
  ],
  "variants": [],
  "metricSubject": "ego"
}
