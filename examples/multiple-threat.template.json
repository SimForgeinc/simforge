{
  "scenarioVersion": 2,
  "meta": {
    "name": "Multiple threat — pedestrian out of a stopped queue in the kerb lane",
    "description": "The US 'multiple threat' geometry: traffic in the kerb lane has stopped, a pedestrian crosses in front of the stopped lead vehicle, and the ego — in the lane beside it, with a clear road ahead of *itself* — has no line of sight until the pedestrian steps past the queue. The reference lane is the kerb lane, so the ego binds one lane to its left (`lane_offset k = +1`), which is also what selects the sites: a corridor whose reference lane has no left neighbour is infeasible, and that is exactly the corridor this scenario does not mean. The queue is the occluder, and it is modelled as L3 props rather than as actors on purpose — see the campaign report: the engine's pairwise TTC is lane-agnostic and circumscribes both footprints, so any *actor* standing 3.5 m to the ego's side drives the episode's min-TTC to zero and steals the metric from the pedestrian.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "C5.multiple-threat",
    "tags": [
      "vru",
      "occlusion",
      "multiple-threat",
      "stopped-queue",
      "prop-occluder",
      "campaign-occluded-pedestrian"
    ],
    "author": "agent/campaign-occluded-pedestrian",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      {
        "id": "arrivalTtc",
        "type": "continuous",
        "description": "Seconds between the pedestrian reaching the ego lane and the ego reaching the same point.",
        "unit": "s",
        "tier": 1,
        "range": [
          1.65,
          1.9
        ],
        "default": 1.775,
        "distribution": "uniform"
      },
      {
        "id": "pedSpeedKph",
        "type": "continuous",
        "description": "Pedestrian travel speed; Euro NCAP walk = 5 km/h, run = 8 km/h.",
        "unit": "kph",
        "tier": 1,
        "range": [
          4.5,
          6.0
        ],
        "default": 5.25,
        "distribution": "uniform"
      },
      {
        "id": "queueGapM",
        "type": "continuous",
        "description": "Metres between the stopped lead vehicle's centre and the line the pedestrian crosses on. Small values put the pedestrian right across the lead vehicle's bonnet.",
        "unit": "m",
        "tier": 1,
        "range": [
          10.5,
          13.0
        ],
        "default": 11.75,
        "distribution": "uniform"
      },
      {
        "id": "dartLeadM",
        "type": "continuous",
        "description": "Short kerbside approach before the pedestrian enters the stopped lane.",
        "unit": "m",
        "tier": 1,
        "range": [8, 14],
        "default": 11,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
  "environment": {
    "weather": "clear",
    "timeOfDay": "afternoon"
  },
  "anchor": {
    "id": "multiple-threat",
    "corridor": {
      "throughLanesSameDir": {
        "value": [
          2,
          8
        ],
        "essentiality": "required"
      },
      "speedLimitKph": {
        "value": [
          30,
          65
        ],
        "essentiality": "preferred",
        "weight": 3
      },
      "requiresAdjacent": {
        "value": [
          "sidewalk"
        ],
        "essentiality": "preferred",
        "weight": 2
      },
      "curvatureDegPer10m": {
        "value": [
          0,
          7
        ],
        "essentiality": "required"
      },
      "runwayDownstreamM": {
        "value": [
          210,
          null
        ],
        "essentiality": "required"
      }
    },
    "features": [
      {
        "id": "masked-crosswalk",
        "kind": "crossing",
        "label": "the exact marked crossing occupied by the hidden pedestrian",
        "essentiality": "required",
        "atM": {
          "value": [100, 150],
          "essentiality": "required"
        },
        "marked": {
          "value": true,
          "essentiality": "preferred"
        },
        "placement": {
          "value": "either",
          "essentiality": "preferred"
        }
      }
    ],
    "policy": {
      "allowMirror": false,
      "maxSitesPerMap": 8,
      "diversity": "moderate",
      "minScore": 0.5
    }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "lane_offset",
      "label": "the vehicle under test, in the lane to the left of the stopped queue",
      "actor": {
        "class": "car",
        "catalogId": "vehicle.sedan"
      },
      "essentiality": "required",
      "k": 1,
      "onMissing": "fail",
      "pose": {
        "laneOffset": 1,
        "s": "-clamp(0.8 * lane.speedLimitKph, 22, 50) / 3.6 * 8",
        "tFrac": 0,
        "headingOffsetRad": 0
      },
      "initialSpeedKph": "clamp(0.8 * lane.speedLimitKph, 22, 50)",
      "extensions": { "placementFeature": "masked-crosswalk" }
    },
    {
      "id": "ped",
      "kind": "on_crossing",
      "label": "the pedestrian crossing in front of the stopped queue",
      "actor": {
        "class": "pedestrian"
      },
      "essentiality": "required",
      "feature": "masked-crosswalk",
      "startFrac": 0,
      "direction": "near_to_far",
      "initialSpeedKph": "param.pedSpeedKph",
      "extensions": { "placementFeature": "masked-crosswalk" }
    }
  ],
  "props": [
    {
      "id": "stopped-queue",
      "catalogId": "vehicle.van",
      "label": "the halted kerb-lane queue the pedestrian steps out of; the lead vehicle sits `queueGapM` upstream of the crossing line",
      "essentiality": "required",
      "feature": "masked-crosswalk",
      "pose": {
        "laneOffset": 0,
        "s": "-18 - param.queueGapM",
        "tFrac": 0,
        "headingOffsetRad": 0
      },
      "headingOffsetRad": 0,
      "scale": 1,
      "repeat": {
        "count": 4,
        "spacingM": 6.0,
        "tFracStep": 0
      },
      "occludes": {
        "observer": "ego",
        "target": "ped"
      },
      "targetRevealToConflictS": 0.8
    }
  ],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "ped-commits",
        "label": "the pedestrian trusts the stopped queue and does not check the second lane",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.collisionAvoidance",
          "value": false
        }
      },
      {
        "id": "ped-ignores-traffic",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.yieldToVehicles",
          "value": false
        }
      },
      {
        "id": "ped-crosses",
        "label": "walks briefly along the kerb, then crosses the stopped lane into the adjacent ego lane",
        "actor": "ped",
        "verb": "route",
        "trigger": { "kind": "at", "t": 0 },
        "target": {
          "mode": "polyline",
          "points": [
            { "laneOffset": 0, "s": "-param.dartLeadM", "tFrac": -1, "headingOffsetRad": 0 },
            { "laneOffset": 0, "s": 0, "tFrac": -1, "headingOffsetRad": 0 },
            { "laneOffset": 1, "s": 0, "tFrac": 0, "headingOffsetRad": 0 },
            { "laneOffset": 1, "s": 0, "tFrac": 1, "headingOffsetRad": 0 }
          ]
        }
      },
      {
        "id": "ped-reaches-the-ego-lane",
        "label": "arrival, aimed at the reference centreline (a PointRef pose carries no tFrac) and compensated by the lane width the pedestrian still has to walk",
        "actor": "ped",
        "verb": "speed",
        "trigger": {
          "kind": "arrival",
          "of": "ped",
          "at": { "feature": "masked-crosswalk", "at": "center" },
          "syncWith": "ego",
          "ttc": "param.arrivalTtc"
        },
        "target": {
          "mode": "absolute",
          "valueKph": "param.pedSpeedKph"
        },
        "dynamics": {
          "shape": "step",
          "constraint": "time",
          "value": 0.1
        }
      }
    ]
  },
  "invariants": [
    {
      "id": "criticality",
      "kind": "pet",
      "label": "the ego must actually be threatened by the pedestrian",
      "essentiality": "required",
      "of": "ego",
      "to": "ped",
      "range": [
        0.2,
        3.0
      ]
    },
    {
      "id": "arrival-band",
      "kind": "arrival",
      "label": "the solved arrival offset must survive at the mapped crossing centre",
      "essentiality": "required",
      "of": "ped",
      "at": { "feature": "masked-crosswalk", "at": "center" },
      "syncWith": "ego",
      "deltaTRange": [
        -2.7,
        -0.6
      ]
    },
    {
      "id": "ego-decel-budget",
      "kind": "decel_budget",
      "label": "beyond a hard stop the conflict was unavoidable, which is a different finding",
      "essentiality": "preferred",
      "of": "ego",
      "maxMps2": 8.0
    }
  ],
  "variants": [],
  "metricSubject": "ego"
}
