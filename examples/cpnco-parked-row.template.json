{
  "scenarioVersion": 2,
  "meta": {
    "name": "CPNCO — dart-out from behind a prop parked row",
    "description": "Crossing Pedestrian, Not at Crossing, Obscured — the portable rendition. The sibling template `cpnco-dartout` requires a true kerb-parking cross-section (`requiresAdjacent: ['parking']`), which exists on exactly one of the five maps: every other map has parking *lots*, not parking *lanes*. This variant carries its own occluder wall instead: a row of four parked SUVs placed as L3 props at the kerb edge of the ego lane, so the scenario transfers to any urban corridor with enough runway. The pedestrian walks the pavement line behind that row and steps into the carriageway without looking (`rules.collisionAvoidance: false`), and the arrival solver back-solves its start so it reaches the ego lane `arrivalTtc` seconds before the ego does. The metric that carries the archetype is reveal-to-conflict: how long ego has line of sight before the conflict, tuned by `occluderGapM` — how far the last parked car sits upstream of the dart point.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "C5.cpnco-dartout",
    "tags": [
      "vru",
      "occlusion",
      "midblock",
      "parked-row",
      "prop-occluder",
      "campaign-occluded-pedestrian"
    ],
    "author": "agent/campaign-occluded-pedestrian",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      {
        "id": "arrivalTtc",
        "type": "continuous",
        "description": "Seconds between the pedestrian reaching the ego lane centre and the ego reaching the same point. Below ~1.5 s no production AEB stops in time; 2.5 s is a comfortable but real event.",
        "unit": "s",
        "tier": 1,
        "range": [
          0.8,
          2.5
        ],
        "default": 1.6,
        "distribution": "uniform"
      },
      {
        "id": "pedSpeedKph",
        "type": "continuous",
        "description": "Pedestrian travel speed. Euro NCAP uses 5 km/h for a walking VRU and 8 km/h for a running one; the band covers both and the slow-walker case.",
        "unit": "kph",
        "tier": 1,
        "range": [
          4.0,
          8.5
        ],
        "default": 5.4,
        "distribution": "uniform"
      },
      {
        "id": "occluderGapM",
        "type": "continuous",
        "description": "Metres between the last parked car and the dart point. This is the reveal-to-conflict axis: a short gap keeps the pedestrian hidden until the last moment, a long gap gives the ego a look.",
        "unit": "m",
        "tier": 1,
        "range": [
          0.0,
          7.0
        ],
        "default": 3.0,
        "distribution": "uniform"
      },
      {
        "id": "dartLeadM",
        "type": "continuous",
        "description": "Metres upstream of the dart point at which the pedestrian leaves the pavement line. A short lead is a steep step-out and a short reveal; a long lead is a diagonal walk that the ego sees earlier.",
        "unit": "m",
        "tier": 1,
        "range": [
          1.5,
          4.5
        ],
        "default": 2.8,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
  "environment": {
    "weather": "clear",
    "timeOfDay": "afternoon"
  },
  "anchor": {
    "id": "cpnco-parked-row",
    "corridor": {
