  ],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "ped-commits",
        "label": "the pedestrian does not look — the defining property of a dart-out",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.collisionAvoidance",
          "value": false
        }
      },
      {
        "id": "ped-ignores-traffic",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.yieldToVehicles",
          "value": false
        }
      },
      {
        "id": "ped-walks-out",
        "label": "along the pavement behind the parked row, then straight into the carriageway",
        "actor": "ped",
        "verb": "route",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "mode": "polyline",
          "points": [
            {
              "laneOffset": 0,
              "s": 60,
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": 0,
              "s": "125 - param.dartLeadM",
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": 0,
              "s": 126,
              "tFrac": 0.15,
              "headingOffsetRad": 0
            }
          ]
        }
      },
      {
        "id": "ped-reaches-the-lane",
        "label": "the arrival relation that makes the clip critical rather than incidental",
        "actor": "ped",
        "verb": "speed",
        "trigger": {
          "kind": "arrival",
          "of": "ped",
          "at": {
            "pose": {
              "laneOffset": 0,
              "s": 125,
              "tFrac": 0,
              "headingOffsetRad": 0
            }
          },
          "syncWith": "ego",
          "ttc": "param.arrivalTtc"
        },
        "target": {
          "mode": "absolute",
          "valueKph": "param.pedSpeedKph"
        },
        "dynamics": {
          "shape": "step",
          "constraint": "time",
          "value": 0.1
        }
      }
    ]
  },
  "invariants": [
