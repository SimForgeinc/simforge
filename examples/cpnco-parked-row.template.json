    }
  ],
  "props": [
    {
      "id": "parked-row",
      "catalogId": "vehicle.suv",
      "label": "five parked SUVs nose-to-tail at the kerb; the last one ends `occluderGapM` upstream of the dart point",
      "essentiality": "required",
      "pose": {
        "laneOffset": 0,
        "s": "114.4 - param.occluderGapM",
        "tFrac": -0.78,
        "headingOffsetRad": 0
      },
      "headingOffsetRad": 0,
