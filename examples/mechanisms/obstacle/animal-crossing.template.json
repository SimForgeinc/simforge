{
  "scenarioVersion": 2,
  "meta": {
    "name": "Animal runs into the roadway",
    "description": "A semantic animal actor runs from the roadside across ego's path at a solved arrival time, then remains at its terminal pose for the aftermath.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "obstacle.animal-crossing",
    "tags": ["obstacle", "animal", "crossing-path", "midblock", "stable-aftermath"],
    "author": "agent/obstacle-mechanisms",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      { "id": "arrivalTtc", "type": "continuous", "description": "Solved arrival separation at the ego-path conflict point.", "unit": "s", "tier": 1, "range": [1.2, 2.5], "default": 1.8, "distribution": "uniform" },
      { "id": "animalSpeedKph", "type": "continuous", "description": "Bounded animal running speed.", "unit": "kph", "tier": 1, "range": [16, 28], "default": 22, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "dawn" },
  "anchor": {
    "id": "animal-crossing",
    "corridor": {
      "throughLanesSameDir": { "value": [1, 4], "essentiality": "required" },
      "speedLimitKph": { "value": [30, 75], "essentiality": "preferred", "weight": 2 },
      "curvatureDegPer10m": { "value": [0, 12], "essentiality": "preferred" },
      "runwayDownstreamM": { "value": [120, null], "essentiality": "required" }
    },
    "features": [],
    "policy": { "allowMirror": true, "maxSitesPerMap": 12, "diversity": "moderate", "minScore": 0.5 }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "on_reference",
      "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "pose": { "laneOffset": 0, "s": 18, "tFrac": 0, "headingOffsetRad": 0 },
      "initialSpeedKph": "clamp(0.82 * lane.speedLimitKph, 30, 55)"
    },
    {
      "id": "animal",
      "kind": "on_reference",
      "label": "running animal crossing from the roadside",
      "actor": { "class": "animal", "dims": { "length": 1.5, "width": 0.55, "height": 1.25 } },
      "pose": { "laneOffset": 0, "s": 70, "tFrac": -1, "headingOffsetRad": 0 },
      "initialSpeedKph": "param.animalSpeedKph"
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 0,
    "interactions": [
      { "id": "animal-does-not-avoid", "actor": "animal", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "rules.collisionAvoidance", "value": false } },
      {
        "id": "animal-crosses-road",
        "actor": "animal",
        "verb": "route",
        "trigger": { "kind": "at", "t": 0 },
        "target": {
          "mode": "polyline",
          "points": [
            { "laneOffset": 0, "s": 70, "tFrac": -1, "headingOffsetRad": 0 },
            { "laneOffset": 0, "s": 98, "tFrac": -1, "headingOffsetRad": 0 },
            { "laneOffset": 0, "s": 100, "tFrac": 1, "headingOffsetRad": 0 }
          ]
        }
      },
      {
        "id": "animal-arrival",
        "actor": "animal",
        "verb": "speed",
        "trigger": {
          "kind": "arrival",
          "of": "animal",
          "at": { "pose": { "laneOffset": 0, "s": 100, "tFrac": 0, "headingOffsetRad": 0 } },
          "syncWith": "ego",
          "ttc": "param.arrivalTtc"
        },
        "target": { "mode": "absolute", "valueKph": "param.animalSpeedKph" },
        "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 }
      }
    ]
  },
  "invariants": [
    { "id": "animal-criticality", "kind": "pet", "of": "ego", "to": "animal", "range": [0.2, 3], "essentiality": "required" },
    { "id": "animal-arrival-band", "kind": "arrival", "of": "animal", "at": { "pose": { "laneOffset": 0, "s": 100, "tFrac": 0, "headingOffsetRad": 0 } }, "syncWith": "ego", "deltaTRange": [-2.7, 2.7], "essentiality": "required" },
    { "id": "animal-avoidance-budget", "kind": "decel_budget", "of": "ego", "maxMps2": 8, "essentiality": "required" }
  ],
  "variants": [],
  "metricSubject": "ego"
}
