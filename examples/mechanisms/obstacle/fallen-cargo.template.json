{
  "scenarioVersion": 2,
  "meta": {
    "name": "Fallen cargo blocks part of the lane",
    "description": "A bounded, collidable static cargo object occupies part of ego's lane and forces a controlled stop after a limited preview.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "obstacle.fallen-cargo",
    "tags": ["obstacle", "fallen-cargo", "static-object", "partial-lane-blockage"],
    "author": "agent/obstacle-mechanisms",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      { "id": "previewDistanceM", "type": "continuous", "description": "Distance at which ego commits to braking for the cargo.", "unit": "m", "tier": 1, "range": [38, 55], "default": 46, "distribution": "uniform" },
      { "id": "cargoOffsetFrac", "type": "continuous", "description": "Cargo lateral centre, preserving a partial rather than total blockage.", "unit": "lane-width", "tier": 1, "range": [0.1, 0.3], "default": 0.2, "distribution": "uniform" },
      { "id": "brakeDurationS", "type": "continuous", "description": "Controlled-stop duration.", "unit": "s", "tier": 1, "range": [2.6, 3.8], "default": 3.2, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "noon" },
  "anchor": {
    "id": "fallen-cargo",
    "corridor": {
      "throughLanesSameDir": { "value": [1, 4], "essentiality": "required" },
      "laneWidthM": { "value": [2.8, 4.5], "essentiality": "required" },
      "speedLimitKph": { "value": [30, 70], "essentiality": "preferred", "weight": 2 },
      "curvatureDegPer10m": { "value": [0, 10], "essentiality": "preferred" },
      "runwayDownstreamM": { "value": [120, null], "essentiality": "required" }
    },
    "features": [],
    "policy": { "allowMirror": true, "maxSitesPerMap": 12, "diversity": "moderate", "minScore": 0.5 }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "on_reference",
      "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "pose": { "laneOffset": 0, "s": 15, "tFrac": 0, "headingOffsetRad": 0 },
      "initialSpeedKph": "clamp(0.8 * lane.speedLimitKph, 28, 52)"
    },
    {
      "id": "cargo",
      "kind": "on_reference",
      "label": "fallen load with a physical collision footprint",
      "actor": {
        "class": "static_object",
        "catalogId": "hazard.cardboard_box",
        "dims": { "length": 1.8, "width": 1.3, "height": 0.9 },
        "static": true
      },
      "pose": { "laneOffset": 0, "s": 48, "tFrac": "param.cargoOffsetFrac", "headingOffsetRad": 0.35 },
      "initialSpeedKph": 0
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 6,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "ego-brakes-for-cargo",
        "actor": "ego",
        "verb": "speed",
        "trigger": {
          "kind": "when",
          "condition": { "kind": "distance", "from": "ego", "to": { "role": "cargo" }, "measure": "alongLane", "op": "<=", "valueM": "param.previewDistanceM" },
          "byLatest": 7,
          "ifNever": "fire"
        },
        "target": { "mode": "stop" },
        "dynamics": { "shape": "linear", "constraint": "time", "value": "param.brakeDurationS" }
      }
    ]
  },
  "invariants": [
    { "id": "cargo-criticality", "kind": "ttc", "of": "ego", "to": "cargo", "range": [0.8, 4.5], "mode": "min", "essentiality": "required" },
    { "id": "cargo-stop-budget", "kind": "decel_budget", "of": "ego", "maxMps2": 8, "essentiality": "required" }
  ],
  "variants": [],
  "metricSubject": "ego"
}
