{
  "scenarioVersion": 2,
  "meta": {
    "name": "Adult midblock crossing",
    "description": "An adult walks continuously along the road edge, turns into ego's travel lane at an unmarked midblock location, passes through the declared lane-centre conflict point, and finishes beyond the far edge for a stable aftermath. The portable frame-relative path does not claim a mapped or controlled crossing.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "vru.adult-midblock-crossing",
    "tags": ["vru", "adult", "midblock", "unmarked-crossing", "stable-aftermath"],
    "author": "agent/junction-vru",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      { "id": "arrivalTtc", "type": "continuous", "description": "Seconds between the pedestrian and ego reaching the corridor centreline conflict point; the pedestrian clears immediately ahead of ego without making the encounter trivially safe.", "unit": "s", "tier": 1, "range": [0.75, 1.15], "default": 0.95, "distribution": "uniform" },
      { "id": "walkingSpeedKph", "type": "continuous", "description": "Adult walking speed.", "unit": "kph", "tier": 1, "range": [4.2, 6.5], "default": 5.2, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "afternoon" },
  "anchor": {
    "id": "adult-midblock-crossing",
    "corridor": {
      "throughLanesSameDir": { "value": [1, 3], "essentiality": "required" },
      "speedLimitKph": { "value": [25, 60], "essentiality": "preferred" },
      "curvatureDegPer10m": { "value": [0, 7], "essentiality": "required" },
      "runwayDownstreamM": { "value": [150, null], "essentiality": "required" }
    },
    "features": [],
    "policy": { "allowMirror": false, "maxSitesPerMap": 12, "diversity": "moderate", "minScore": 0.5 }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "on_reference",
      "label": "the vehicle under test",
      "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "essentiality": "required",
      "pose": { "laneOffset": 0, "s": "100 - (clamp(0.8 * lane.speedLimitKph, 22, 48) / 3.6) * 7", "tFrac": 0, "headingOffsetRad": 0 },
      "initialSpeedKph": "clamp(0.8 * lane.speedLimitKph, 22, 48)"
    },
    {
      "id": "pedestrian",
      "kind": "on_reference",
      "label": "the adult crossing laterally through ego's lane",
      "actor": { "class": "pedestrian", "catalogId": "pedestrian.adult_walking" },
      "essentiality": "required",
      "pose": { "laneOffset": 0, "s": 80, "tFrac": -1, "headingOffsetRad": 0 },
      "initialSpeedKph": "param.walkingSpeedKph"
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 1,
    "interactions": [
      { "id": "pedestrian-commits", "actor": "pedestrian", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "rules.collisionAvoidance", "value": false } },
      {
        "id": "pedestrian-crosses",
        "actor": "pedestrian",
        "verb": "route",
        "trigger": { "kind": "at", "t": 0 },
        "target": {
          "mode": "polyline",
          "points": [
            { "laneOffset": 0, "s": 80, "tFrac": -1, "headingOffsetRad": 0 },
            { "laneOffset": 0, "s": 100, "tFrac": -1, "headingOffsetRad": 0 },
            { "laneOffset": 0, "s": 100, "tFrac": 0, "headingOffsetRad": 0 },
            { "laneOffset": 0, "s": 100, "tFrac": 1, "headingOffsetRad": 0 }
          ]
        }
      },
      {
        "id": "pedestrian-arrival",
        "actor": "pedestrian",
        "verb": "speed",
        "trigger": { "kind": "arrival", "of": "pedestrian", "at": { "pose": { "laneOffset": 0, "s": 100, "tFrac": 0, "headingOffsetRad": 0 } }, "syncWith": "ego", "ttc": "param.arrivalTtc" },
        "target": { "mode": "absolute", "valueKph": "param.walkingSpeedKph" },
        "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 }
      }
    ]
  },
  "invariants": [
    { "id": "criticality", "kind": "pet", "essentiality": "required", "of": "ego", "to": "pedestrian", "range": [0.2, 3] },
    { "id": "arrival-band", "kind": "arrival", "essentiality": "required", "of": "pedestrian", "at": { "pose": { "laneOffset": 0, "s": 100, "tFrac": 0, "headingOffsetRad": 0 } }, "syncWith": "ego", "deltaTRange": [-1.3, -0.65] },
    { "id": "ego-decel-budget", "kind": "decel_budget", "essentiality": "preferred", "of": "ego", "maxMps2": 8 }
  ],
  "variants": [],
  "metricSubject": "ego"
}
