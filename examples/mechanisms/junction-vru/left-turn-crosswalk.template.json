{
  "scenarioVersion": 2,
  "meta": {
    "name": "Left turn across a far-side pedestrian crossing",
    "description": "Ego follows a map-derived left-turn movement into a marked receiving-leg crossing while an adult pedestrian walks completely across and remains at the terminal pose for the aftermath. The crossing and turn are required map features rather than assumed semantics.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "simforge/0.0.1",
    "archetype": "intersection.left-turn-crosswalk",
    "tags": ["junction", "vru", "left-turn", "far-side-crosswalk", "stable-aftermath"],
    "author": "agent/junction-vru",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      { "id": "arrivalTtc", "type": "continuous", "description": "Seconds between ego and pedestrian arrival at the far-side crossing.", "unit": "s", "tier": 1, "range": [2.2, 2.25], "default": 2.23, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "noon" },
  "anchor": {
    "id": "left-turn-crosswalk",
    "corridor": {
      "throughLanesSameDir": { "value": [1, 4], "essentiality": "required" },
      "throughLanesOpposing": { "value": [1, 4], "essentiality": "required" },
      "speedLimitKph": { "value": [20, 60], "essentiality": "preferred" },
      "runwayUpstreamM": { "value": [55, null], "essentiality": "required" },
      "runwayDownstreamM": { "value": [40, null], "essentiality": "required" }
    },
    "features": [
      {
        "id": "jx",
        "kind": "junction",
        "label": "the junction where ego turns left",
        "essentiality": "required",
        "atM": { "value": [0, 0], "essentiality": "required" },
        "arms": { "value": [3, 4], "essentiality": "preferred" },
        "control": { "value": ["signalized"], "essentiality": "required" },
        "egoTurn": { "value": ["left"], "essentiality": "required" },
        "hasCrossingOnLeg": { "value": true, "essentiality": "required" }
      },
      {
        "id": "xw",
        "kind": "crossing",
        "label": "the receiving-road crossing",
        "essentiality": "required",
        "atM": { "value": [0, 28], "essentiality": "required" }
      }
    ],
    "policy": { "allowMirror": false, "maxSitesPerMap": 12, "diversity": "strict", "minScore": 0.45 }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "on_reference",
      "label": "the left-turning vehicle under test",
      "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "essentiality": "required",
      "pose": { "laneOffset": 0, "s": "-(clamp(0.5 * lane.speedLimitKph, 12, 26) / 3.6) * 8.5", "tFrac": 0, "headingOffsetRad": 0 },
      "initialSpeedKph": "clamp(0.5 * lane.speedLimitKph, 12, 26)"
    },
    {
      "id": "pedestrian",
      "kind": "on_crossing",
      "label": "the pedestrian crossing the receiving road",
      "actor": { "class": "pedestrian", "catalogId": "pedestrian.adult_walking" },
      "essentiality": "required",
      "feature": "xw",
      "startFrac": 0.05,
      "direction": "near_to_far",
      "lateralFrac": 0,
      "initialSpeedKph": 3.6
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "ego-bound-signal-proceeds",
        "actor": "@world",
        "verb": "set",
        "trigger": { "kind": "at", "t": 0 },
        "target": { "key": "signal:feature:jx:ego.phase", "value": "green" }
      },
      { "id": "ego-yields-through-turn", "actor": "ego", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "rules.collisionAvoidance", "value": true } },
      { "id": "pedestrian-commits", "actor": "pedestrian", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "rules.collisionAvoidance", "value": false } },
      {
        "id": "pedestrian-arrival",
        "actor": "pedestrian",
        "verb": "speed",
        "trigger": { "kind": "arrival", "of": "pedestrian", "at": { "feature": "xw", "at": "center" }, "syncWith": "ego", "ttc": "param.arrivalTtc" },
        "target": { "mode": "absolute", "valueKph": 5.4 },
        "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 }
      }
    ]
  },
  "invariants": [
    { "id": "criticality", "kind": "pet", "essentiality": "required", "of": "ego", "to": "pedestrian", "range": [0.2, 3] },
    { "id": "arrival-band", "kind": "arrival", "essentiality": "required", "of": "pedestrian", "at": { "feature": "xw", "at": "center" }, "syncWith": "ego", "deltaTRange": [-2.7, -2] },
    { "id": "ego-decel-budget", "kind": "decel_budget", "essentiality": "preferred", "of": "ego", "maxMps2": 8 }
  ],
  "variants": [],
  "metricSubject": "ego"
}
