      "initialSpeedKph": "clamp(0.65 * lane.speedLimitKph, 18, 35)",
      "extensions": { "placementFeature": "parking" }
    },
    {
      "id": "backing-vehicle", "kind": "in_parking_zone", "label": "perpendicularly parked vehicle reversing rear-first into ego's aisle",
      "actor": { "class": "car", "catalogId": "vehicle.suv" },
      "feature": "parking", "slot": "any", "facing": "perpendicular",
      "initialSpeedKph": 0,
      "extensions": { "placementFeature": "parking", "motionSemantics": "reverse" }
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 12,
    "warmupSeconds": 2,
    "interactions": [
      { "id": "backing-path", "actor": "backing-vehicle", "verb": "route", "trigger": { "kind": "at", "t": 0 }, "target": { "mode": "polyline", "points": [
        { "laneOffset": 0, "s": 0, "tFrac": -1, "headingOffsetRad": 1.5707963267948966 },
        { "laneOffset": 0, "s": -2, "tFrac": -0.55, "headingOffsetRad": 2.2 },
        { "laneOffset": 0, "s": -5, "tFrac": 0, "headingOffsetRad": 3.141592653589793 }
      ] } },
      { "id": "reverse-lamps-on", "actor": "backing-vehicle", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "lights.reverse", "value": true } },
      { "id": "backing-disables-avoidance", "actor": "backing-vehicle", "verb": "set", "trigger": { "kind": "at", "t": 0.5 }, "target": { "key": "rules.collisionAvoidance", "value": false } },
      { "id": "ego-brakes-for-reversing-vehicle", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "reverse-lamps-on", "event": "start", "delayS": 0.35 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "rate", "value": 6 } },
      { "id": "backing-begins", "actor": "backing-vehicle", "verb": "speed", "trigger": { "kind": "when", "condition": { "kind": "distance", "from": "ego", "to": { "role": "backing-vehicle" }, "measure": "euclidean", "op": "<=", "valueM": "param.reverseTriggerDistanceM" }, "byLatest": 8, "ifNever": "fire" }, "target": { "mode": "absolute", "valueKph": "param.reverseSpeedKph" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 1.2 } }
