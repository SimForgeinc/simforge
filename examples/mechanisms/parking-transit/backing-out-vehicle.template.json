      { "id": "reverseTriggerDistanceM", "type": "continuous", "unit": "m", "tier": 1, "range": [18, 28], "default": 23, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "afternoon" },
