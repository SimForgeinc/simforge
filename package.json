{
  "name": "uniscenarios",
  "description": "Portable driving-scenario authoring, simulation, rendering, validation, and standards export toolkit.",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @uniscenarios/cloud dev",
    "dev:worker": "UNISCENARIOS_LOCAL_WORKER=1 pnpm --filter @uniscenarios/cloud dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:portable": "pnpm --filter @uniscenarios/scenario-model --filter @uniscenarios/sim-engine --filter @uniscenarios/scenario-materializer --filter @uniscenarios/editor-core --filter @uniscenarios/city-renderer --filter @uniscenarios/prop-catalog --filter @uniscenarios/ambient-traffic --filter @uniscenarios/camera-rig --filter @uniscenarios/playback --filter @uniscenarios/openscenario --filter @uniscenarios/trace-comparator --filter @uniscenarios/xodr-tools --filter @uniscenarios/map-intel --filter @uniscenarios/anchor-matcher --filter @uniscenarios/esmini-runner --filter @uniscenarios/browser-renderer test && pnpm --filter @uniscenarios/cli test:portable",
    "test:render-presets:browser": "node scripts/verify-render-presets-browser.mjs",
    "typecheck": "pnpm -r --filter \"./packages/**\" build && pnpm -r typecheck",
    "render:export": "node scripts/export-render.mjs",
    "render:run": "pnpm --filter @uniscenarios/cli uniscenarios render run",
    "render:worker": "pnpm --filter @uniscenarios/render-worker start",
    "render:batch": "node scripts/render-scenario-batch.mjs",
    "render:review": "node scripts/review-scenario-evidence.mjs",
    "trace:render": "node scripts/render-trace.mjs",
    "render:qualification": "node scripts/render-qualification.mjs",
    "verify:naming": "node scripts/verify-repository-naming.mjs",
    "verify:fresh-sumo": "node scripts/verify-fresh-launch-sumo.mjs",
    "maps:derivatives": "node scripts/build-map-derivatives.mjs",
    "maps:derivatives:smoke": "node scripts/smoke-map-derivative-toolchain.mjs",
    "release:manifest": "node scripts/release/generate-stack-manifest.mjs --out artifacts/release/uniscenarios-stack.json",
    "release:verify-artifacts": "node scripts/release/verify-package-artifacts.mjs",
    "release:smoke-packages": "node scripts/release/smoke-packed-stack.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "integration:audit": "node scripts/integration/audit-simcloud-divergence.mjs",
    "integration:compare-engine": "tsx scripts/integration/compare-engine-behavior.ts",
    "test:integration": "node --test scripts/integration/*.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "sharp": "0.34.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
